{
  "name": "lan-scan-gun",
  "version": "1.0.3",
  "description": "Use a mobile phone as a LAN barcode scanner for Windows and macOS.",
  "main": "electron/main.cjs",
  "author": "Lan Scan Gun",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "node electron/build-macos-input.cjs && vite build",
    "test": "node --test tests/*.test.cjs",
    "preview": "node electron/preview.cjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --x64 -c.directories.output=outputs/macos"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "lucide": "^0.468.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.4.1"
  },
  "build": {
    "directories": { "output": "outputs/windows" },
    "appId": "com.lanscangun.desktop",
    "productName": "LAN Scan Gun",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/bin/module-cache/**/*",
      "!electron/build-macos-input.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "binaries": ["Contents/Resources/app.asar.unpacked/electron/bin/input-macos"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asarUnpack": ["electron/input.ps1", "electron/bin/input-macos"]
  }
}
